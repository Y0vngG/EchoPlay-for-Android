<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="@string/echoplay_orbit_back_path"
        android:strokeAlpha="0.8"
        android:strokeLineCap="round"
        android:strokeWidth="1.35">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25"
                android:startY="63"
                android:endX="84"
                android:endY="48"
                android:startColor="#7AF7FF"
                android:endColor="#E9ABFF" />
        </aapt:attr>
    </path>
    <path
        android:pathData="@string/echoplay_note_path"
        android:strokeColor="#66CBF6FF"
        android:strokeLineJoin="round"
        android:strokeWidth="0.55">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="53"
                android:startY="31"
                android:endX="57"
                android:endY="78">
                <item android:offset="0" android:color="#CAFFF7" />
                <item android:offset="0.37" android:color="#44C9FC" />
                <item android:offset="0.62" android:color="#6F9CFF" />
                <item android:offset="1" android:color="#D45DF3" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="@string/echoplay_orbit_front_path"
        android:strokeColor="#407AF2FF"
        android:strokeLineCap="round"
        android:strokeWidth="2.65" />
    <path
        android:pathData="@string/echoplay_orbit_front_path"
        android:strokeLineCap="round"
        android:strokeWidth="1.55">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25"
                android:startY="63"
                android:endX="84"
                android:endY="48"
                android:startColor="#7AF7FF"
                android:endColor="#FFC0F8" />
        </aapt:attr>
    </path>
    <path android:pathData="@string/echoplay_orb_path">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="78.2"
                android:centerY="52.55"
                android:gradientRadius="4.65">
                <item android:offset="0" android:color="#F2FFFF" />
                <item android:offset="0.5" android:color="#65D5FF" />
                <item android:offset="1" android:color="#D278FA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
